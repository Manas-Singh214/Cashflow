# ==============================================================================
# Predictive Cash-Withdrawal & Cybercrime Analytics Pipeline — Environment Config
# ==============================================================================
# Copy this file to `.env` and adjust values as needed. `.env` is git-ignored
# so your local overrides never get committed. Every variable below has a
# sensible default baked into the code, so `.env` is OPTIONAL for a normal
# local run — it exists purely for portability / customization.

# ─── Data directories (all default to paths relative to the project root) ───
# Absolute or relative paths are both fine. Leave unset to use the defaults
# defined in data_merge.py / main.ipynb (DATASETS/, MERGED DATASETS/).
PROJECT_BASE_DIR=
BANK_DATA_DIR=
CRIME_DATA_DIR=
MERGED_OUTPUT_DIR=

# ─── Geospatial resources ────────────────────────────────────────────────────
# Local, version-controlled copy of the India state boundaries GeoJSON used
# by the Plotly/Folium choropleth cells. Ships in the repo at data/geo/, so
# the notebook works fully offline — no network dependency required.
INDIA_GEOJSON_PATH=data/geo/india_states.geojson

# ─── Notebook / EDA behavior toggles ─────────────────────────────────────────
# Set to "1" to enable heavier, optional cells (PyGWalker explorers, OSMnx
# network downloads) that require network access or extra compute.
ENABLE_HEAVY_CELLS=0
